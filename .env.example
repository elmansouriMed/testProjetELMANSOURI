# Copiez ce fichier dans .env, puis choisissez vos mots de passe.
DB_PASSWORD=replace-with-a-local-password
MQ_PASSWORD=replace-with-a-local-password
# Le fichier .secrets/mq-app-password.txt doit contenir la même valeur que MQ_PASSWORD.
# Après lecture de la licence IBM MQ Advanced for Developers, utilisez accept.
MQ_LICENSE=
MQ_CONSUMERS=4
DB_POOL_SIZE=16
